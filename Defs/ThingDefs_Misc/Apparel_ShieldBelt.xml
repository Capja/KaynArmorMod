<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Kayn_CinturonCupulaDefensiva</defName>
    <label>cinturón proyector de cúpula</label>
    
    <tickerType>Normal</tickerType>

    <description>Genera una cúpula esférica a su alrededor que desintegra los disparos enemigos que entran...</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ShieldBelt/ShieldBelt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <!-- ESTADÍSTICAS OBLIGATORIAS (Incluyendo masa/peso) -->
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <Mass>3.0</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>2.0</EquipDelay>
    </statBases>

    <costList>
      <Plasteel>50</Plasteel>
      <Uranium>20</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Kayn_TecnologiaTacticoEnergetica</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
    <apparel>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
    <comps>
      <li Class="KaynArmorMod.CompProperties_EnergyToggle">
        <compClass>KaynArmorMod.CompShieldItem</compClass>
        <maxEnergy>200</maxEnergy>
        <energyDrainRatePerTick>0.03</energyDrainRatePerTick>   <!-- Dura más de 1 minuto y medio continuo -->
        <energyRechargeRatePerTick>0.10</energyRechargeRatePerTick> <!-- Recarga completa en ~30s al estar apagado -->
        <toggleLabel>Cúpula Protectora</toggleLabel>
        <toggleDesc>Despliega un escudo cinético. Se recarga cuando está apagado.</toggleDesc>
        <toggleIconPath>UI/Abilities/GuardianSkipbarrier</toggleIconPath>
      </li>
    </comps>
  </ThingDef>
</Defs>