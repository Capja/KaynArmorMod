<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>KaynArmorMod</RootNamespace>
    <AssemblyName>KaynArmorMod</AssemblyName>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- LIBRERÍA DE HARMONY -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.*" />
  </ItemGroup>

  <!-- ================= AJUSTES PARA RIMWORLD 1.6 ================= -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <OutputPath>..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- ================= AJUSTES PARA RIMWORLD 1.7 ================= -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
  </ItemGroup>

</Project>